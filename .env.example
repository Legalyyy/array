# MindLinkQuest - Environment Variables Template
# Copia este archivo a .env y completa los valores

# ============================================
# REQUERIDO - Base de Datos
# ============================================
# URL de conexión a PostgreSQL (Replit la configura automáticamente)
# En Render/Railway: Copia la Internal Database URL
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# REQUERIDO - Discord Bot
# ============================================
# Token del bot de Discord (desde Discord Developer Portal)
DISCORD_BOT_TOKEN=tu_bot_token_aqui

# ID del cliente de Discord (Application ID)
DISCORD_CLIENT_ID=tu_client_id_aqui

# ID del servidor/guild de Discord donde funcionará el bot
DISCORD_GUILD_ID=tu_guild_id_aqui

# ============================================
# REQUERIDO - Seguridad
# ============================================
# Secret para firmar sesiones (genera uno aleatorio)
# Puedes usar: openssl rand -base64 32
SESSION_SECRET=genera_un_string_aleatorio_aqui

# ============================================
# OPCIONAL - Features de IA
# ============================================
# API Key de Google Gemini (para features de IA del bot)
# Obtén una gratis en: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=tu_gemini_api_key_aqui

# ============================================
# AUTOMÁTICO - No editar
# ============================================
# Estas variables las configura automáticamente la plataforma
# NODE_ENV=development|production
# PORT=5000 (en Replit/Render se configura automáticamente)
